# Toegang tot de site (zie TOEGANG.md).
# Online: zet deze in Vercel → Settings → Environment Variables.
# Lokaal: kopieer naar .env.local en vul eigen waarden in.

# Het wachtwoord dat je met geïnteresseerden deelt. Kies een lange zin, geen los woord.
SITE_PASSWORD=

# Wachtwoord voor jullie zelf: geeft ook het bezoekersoverzicht op /api/bezoekers.
# Anders dan SITE_PASSWORD, en niet delen.
ADMIN_PASSWORD=

# Willekeurig geheim van minstens 32 tekens om de sessiecookie mee te ondertekenen.
# Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Opslag van de bezoekregistratie. Online automatisch gezet door de Vercel-integratie
# "Upstash for Redis". Lokaal mag dit leeg blijven: dan staan bezoeken in het geheugen.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
