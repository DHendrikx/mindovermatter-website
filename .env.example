# Analyst Research: omgevingsvariabelen.
# Op Vercel: Project → Settings → Environment Variables (Production én Preview).
# Lokaal: kopieer naar .env.local (staat in .gitignore) en vul in.

# Anthropic API-key van console.anthropic.com. Nooit in de code of in git zetten.
ANTHROPIC_API_KEY=

# Teamwachtwoord voor /research (minimaal 8 tekens).
RESEARCH_PASSWORD=

# Willekeurige sleutel voor het ondertekenen van de sessiecookie (minimaal 16 tekens).
# Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RESEARCH_SESSION_SECRET=

# Optioneel: ander model. Standaard claude-opus-5-5.
# RESEARCH_MODEL=claude-opus-5-5

# Opslag: worden automatisch gezet als je Upstash Redis via de Vercel Marketplace koppelt.
# Lokaal leeg laten: rapporten komen dan in .data/research/.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
